# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://172.20.10.2:5173

# Database Connection (Supabase PostgreSQL / Hosted PostgreSQL)
# Format for Supabase Connection Pooling (Transaction Mode):
DATABASE_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Format for Supabase Direct Connection (Session / Migrations Mode):
DIRECT_URL="postgresql://postgres:[YOUR_DB_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# JWT and Authentication
JWT_SECRET=finsetu_jwt_secret_production_ready_crypto_key_2026_xyz
JWT_EXPIRES_IN=7d
COOKIE_SECRET=finsetu_cookie_secret_secure_hash_token_2026

# Payment Gateway (Razorpay Test Mode)
# Replace with your Razorpay Test Key and Secret from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_finsetu_sample
RAZORPAY_KEY_SECRET=rzp_test_secret_demo_token
